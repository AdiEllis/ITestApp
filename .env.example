# ---- Database (PostgreSQL 14+) ----
DATABASE_URL="postgresql://cobe:cobe@localhost:5432/cobe?schema=public"

# ---- App ----
# Public base URL (used to build absolute links). No trailing slash.
APP_URL="http://localhost:3000"
# Long random string (>= 32 chars). Used to sign local-storage file tokens.
# Optional on hosted setups: if omitted it is derived from DATABASE_URL + S3_SECRET_ACCESS_KEY.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Allow teachers to self-register (true/false). Admins can always create accounts.
ALLOW_TEACHER_SIGNUP="true"

# ---- File storage ----
# "local" stores files on disk under STORAGE_LOCAL_DIR (dev / single server only).
# "s3" uses any S3-compatible private bucket (AWS S3, Cloudflare R2, MinIO, Backblaze B2...).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# Required only when STORAGE_DRIVER="s3"
S3_ENDPOINT=""            # e.g. https://<account>.r2.cloudflarestorage.com (empty for AWS)
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# ---- Data retention ----
# Default number of days to keep student recordings (per-school value overrides). 0 = keep forever.
DEFAULT_RECORDING_RETENTION_DAYS="400"

# Optional: direct (non-pooled) DB URL used only for migrations during deployment (Neon).
DATABASE_URL_UNPOOLED=""
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/retention (daily cleanup).
CRON_SECRET=""

# Optional: "Sign in with Google" (see docs/GOOGLE-SETUP.md). When both are set, Google becomes the main login.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
